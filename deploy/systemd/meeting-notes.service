[Unit]
Description=Meeting Notes Cloud Control Plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=meeting
Group=meeting
WorkingDirectory=/opt/meeting-notes
EnvironmentFile=-/etc/meeting-notes.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/meeting-notes/.venv/bin/python -m server
Restart=always
RestartSec=3
MemoryHigh=240M
MemoryMax=300M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/meeting-notes
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
